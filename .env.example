# Copy this file to .env before running the app.
# No paid API key is required for the local learning version.

DATABASE_URL="postgresql://serp:serp_local_password@localhost:5432/serp?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Generate a long random value before sharing or deploying the app.
JWT_SECRET="replace_with_a_long_random_secret"

# Optional later integration - keep empty while using the free local map mode.
MAP_TILES_URL=""
TRAFFIC_PROVIDER_API_KEY=""
